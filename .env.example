# Environment Configuration
PORT=5000
NODE_ENV=development

# Database (use your PostgreSQL or MySQL connection string)
# Local: postgresql://user:password@localhost:5432/resume_builder
# Production: Use your managed database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/resume_builder

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# External APIs
GROQ_API_KEY=your_groq_api_key_here

# Client URL (for CORS configuration)
# Local: http://localhost:3000
# Production: your-frontend-domain.com
CLIENT_URL=http://localhost:3000

